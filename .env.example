IBKR_HOST=127.0.0.1
IBKR_PORT=7497
# Must differ from tape-reading-tool's default client ID (97).
IBKR_CLIENT_ID=98
PORT=8098

# Optional: change the active chart in a local TradingView Desktop instance.
# Set to true after launching TradingView with its local CDP port enabled.
WATCHLIST_TRADINGVIEW_ENABLED=false
WATCHLIST_TRADINGVIEW_CDP_URL=http://127.0.0.1:9222
WATCHLIST_TRADINGVIEW_TIMEOUT=3s
